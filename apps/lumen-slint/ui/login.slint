// Login / register view — port of apps/desktop/src/lib/components/Login.svelte.
// Pure view: renders state and emits callbacks; all logic lives in Rust.
// The card is centered via nested layouts (VerticalLayout alignment: center),
// NOT via y: (parent.height - self.height)/2 — an element without an explicit
// height in a non-layout parent stretches to fill it, which makes that
// formula evaluate to y=0 (card pinned to the top).

import { AppTheme } from "theme.slint";
import { Button, LineEdit } from "std-widgets.slint";

export component Login inherits Rectangle {
    in property <bool> busy;
    in property <bool> is-register;
    in property <string> error;
    in-out property <string> backend-url;
    in-out property <string> username;
    in-out property <string> password;
    callback submit(string, string);
    callback toggle-mode();
    callback backend-changed(string);

    background: AppTheme.colors.bg;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: AppTheme.login-width;
            background: AppTheme.colors.bg-raised;
            border-radius: AppTheme.radius;
            VerticalLayout {
                padding: 32px;
                spacing: AppTheme.sp-3;

                Text {
                    text: "Lumen";
                    font-size: AppTheme.font-hero;
                    font-weight: 700;
                    color: AppTheme.colors.text;
                }
                Text {
                    text: "ultralight voice for small groups";
                    font-size: AppTheme.font-md;
                    color: AppTheme.colors.text-dim;
                }
                Text {
                    text: "Username";
                    font-size: AppTheme.font-sm;
                    color: AppTheme.colors.text-dim;
                }
                LineEdit {
                    text <=> root.username;
                }
                Text {
                    text: "Password";
                    font-size: AppTheme.font-sm;
                    color: AppTheme.colors.text-dim;
                }
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    accepted => { root.submit(root.username, root.password); }
                }
                Text {
                    visible: root.error != "";
                    text: root.error;
                    font-size: AppTheme.font-md;
                    color: AppTheme.colors.danger;
                    wrap: word-wrap;
                }
                Button {
                    text: root.is-register ? "Create account" : "Sign in";
                    enabled: !root.busy;
                    primary: true;
                    clicked => { root.submit(root.username, root.password); }
                }
                Button {
                    text: root.is-register ? "Have an account? Sign in" : "No account? Register";
                    visible: !root.busy;
                    clicked => { root.toggle-mode(); }
                }
                // Backend URL
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Backend URL";
                        font-size: AppTheme.font-xs;
                        font-weight: 700;
                        color: AppTheme.colors.text-dim;
                    }
                    LineEdit {
                        text <=> root.backend-url;
                    }
                    Button {
                        text: "Apply";
                        clicked => { root.backend-changed(root.backend-url); }
                    }
                }
            }
        }
    }
}
