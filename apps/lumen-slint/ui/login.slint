// Login / register — the gate. Cinzel wordmark, hard-corner card (no rounded
// Material look), pixel inputs, crimson primary. The ember radial wash is the
// single ritual accent on this screen (it IS the welcome moment).

import { AppTheme } from "theme.slint";
import { Icons } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { VoxButton } from "primitives/buttons.slint";
import { VoxLineEdit } from "primitives/inputs.slint";
import { IconGlyph } from "primitives/icon.slint";

export component Login inherits Rectangle {
    in property <bool> busy;
    in property <bool> is-register;
    in property <string> error;
    in-out property <string> backend-url;
    in-out property <string> username;
    in-out property <string> password;
    callback submit(string, string);
    callback toggle-mode();
    callback backend-changed(string);
    callback oauth(string);

    background: AppTheme.colors.bg;

    // ritual glow behind the card
    Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, AppTheme.colors.glow-rose-start 0%, AppTheme.colors.glow-rose-end 55%);
    }

    // Shadow behind card
    Rectangle {
        width: Math.min(AppTheme.login-width, parent.width - 24px);
        height: Math.min(AppTheme.card-max-height, parent.height - 24px);
        x: (parent.width - self.width) / 2 + AppTheme.shadow-offset;
        y: (parent.height - self.height) / 2 + AppTheme.shadow-offset;
        background: AppTheme.colors.bg-deep;
        border-radius: AppTheme.radius-2;
    }

    // Explicitly sized card centered on parent
    Rectangle {
        width: Math.min(AppTheme.login-width, parent.width - 24px);
        height: Math.min(AppTheme.card-max-height, parent.height - 24px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: AppTheme.colors.surface;
        border-width: 1px;
        border-color: AppTheme.colors.border;
        border-radius: AppTheme.radius-2;

        ScrollView {
            width: 100%;
            height: 100%;

            VerticalLayout {
                // Pin the layout to the ScrollView viewport: Flickable computes
                // viewport-width = max(flickable.width, layout.min-width), so
                // unconstrained content (e.g. a long backend URL in the input)
                // inflates min-width → horizontal overflow + scrollbar.
                min-width: 0px;
                padding: AppTheme.sp-5;
                spacing: AppTheme.sp-3;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    spacing: AppTheme.sp-2;
                    cross-axis-alignment: center;

                    IconGlyph {
                        glyph: Icons.fire;
                        size: 26px;
                        text-color: AppTheme.colors.rose;
                    }
                    Text {
                        text: "Lumen";
                        font-family: AppTheme.font-display;
                        font-weight: 900;
                        font-size: AppTheme.font-hero;
                        color: AppTheme.colors.text-hi;
                    }
                }
                Text {
                    text: "ultralight voice for small warbands";
                    font-family: AppTheme.font-mono;
                    font-size: AppTheme.font-xs;
                    color: AppTheme.colors.bronze-hi;
                    horizontal-alignment: center;
                }
                Rectangle { height: AppTheme.sp-2; }
                Text {
                    text: "Usuario";
                    font-family: AppTheme.font-mono;
                    font-size: AppTheme.font-xs;
                    color: AppTheme.colors.text-dim;
                }
                user_fs := VoxLineEdit {
                    text <=> root.username;
                    placeholder: "Nombre de usuario";
                    error: root.error != "";
                    autofocus: true;
                    accepted(text) => { root.submit(root.username, root.password); }
                }
                Text {
                    text: "Contraseña";
                    font-family: AppTheme.font-mono;
                    font-size: AppTheme.font-xs;
                    color: AppTheme.colors.text-dim;
                }
                VoxLineEdit {
                    text <=> root.password;
                    placeholder: "Contraseña";
                    password: true;
                    error: root.error != "";
                    accepted(text) => { root.submit(root.username, root.password); }
                }
                if root.error != "" : Text {
                    text: root.error;
                    font-family: AppTheme.font-mono;
                    font-size: AppTheme.font-xs;
                    color: AppTheme.colors.rose;
                    wrap: word-wrap;
                }
                VoxButton {
                    horizontal-stretch: 1;
                    text: root.is-register ? "Crear cuenta" : "Iniciar sesión";
                    icon: root.is-register ? Icons.pencil-simple : Icons.door-open;
                    primary: true;
                    loading: root.busy;
                    enabled: !root.busy && root.username != "" && root.password != "";
                    clicked => { root.submit(root.username, root.password); }
                }
                VoxButton {
                    horizontal-stretch: 1;
                    text: root.is-register ? "¿Tienes cuenta? Inicia sesión" : "¿Sin cuenta? Regístrate";
                    compact: true;
                    visible: !root.busy;
                    clicked => { root.toggle-mode(); }
                }
                // Fase 4: OAuth social (abre el browser externo).
                Rectangle { height: AppTheme.sp-2; }
                Text {
                    text: "O CONTINÚA CON";
                    font-family: AppTheme.font-mono;
                    font-size: AppTheme.font-xs;
                    letter-spacing: 1px;
                    color: AppTheme.colors.text-mute;
                    horizontal-alignment: center;
                }
                VoxButton {
                    horizontal-stretch: 1;
                    text: "Continuar con Google";
                    compact: true;
                    visible: !root.busy;
                    clicked => { root.oauth("google"); }
                }
                VoxButton {
                    horizontal-stretch: 1;
                    text: "Continuar con GitHub";
                    compact: true;
                    visible: !root.busy;
                    clicked => { root.oauth("github"); }
                }
                Rectangle { height: AppTheme.sp-1; }
                Text {
                    text: "URL del servidor";
                    font-family: AppTheme.font-mono;
                    font-size: AppTheme.font-xs;
                    color: AppTheme.colors.text-dim;
                }
                VoxLineEdit {
                    text <=> root.backend-url;
                    placeholder: "https://...";
                }
                VoxButton {
                    horizontal-stretch: 1;
                    text: "Aplicar";
                    compact: true;
                    clicked => { root.backend-changed(root.backend-url); }
                }
            }
        }
    }
}
