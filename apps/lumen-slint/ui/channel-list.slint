// Channel list — port of apps/desktop/src/lib/components/ChannelList.svelte.
// Pure view; the create-channel modal lives at AppWindow level.

import { AppTheme } from "theme.slint";
import { Button, ScrollView } from "std-widgets.slint";
import { ChannelItem } from "types.slint";
import { HeaderBar, ListRow, Divider } from "base.slint";

export component ChannelList inherits Rectangle {
    in property <[ChannelItem]> channels;
    in property <string> server-name;
    in property <bool> can-create;
    callback select-channel(string);
    callback copy-invite();
    callback open-create-channel();

    width: AppTheme.sidebar-width;
    vertical-stretch: 1;
    background: AppTheme.colors.bg-list;

    VerticalLayout {
        width: 100%;
        height: 100%;
        HeaderBar {
            pad-x: 14px;
            Text {
                text: root.server-name;
                color: AppTheme.colors.text;
                font-size: AppTheme.font-base;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button {
                text: "Invite";
                enabled: root.server-name != "";
                clicked => { root.copy-invite(); }
            }
            Button {
                text: "+";
                enabled: root.can-create;
                clicked => { root.open-create-channel(); }
            }
        }
        Divider { }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding-top: AppTheme.sp-2;
                padding-bottom: AppTheme.sp-2;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;
                HorizontalLayout {
                    alignment: start;
                    padding-left: AppTheme.sp-2;
                    padding-top: AppTheme.sp-1;
                    padding-bottom: AppTheme.sp-1;
                    Text { text: "TEXT"; font-size: AppTheme.font-xs; font-weight: 700; color: AppTheme.colors.text-dim; }
                }
                for c in root.channels: ListRow { visible: c.kind == "text";
                    active: c.active;
                    pad-x: AppTheme.sp-3;
                    clicked => { root.select-channel(c.id); }
                    Text { text: "#"; color: AppTheme.colors.text-dim; font-size: AppTheme.font-md; }
                    Text {
                        text: c.name;
                        color: c.active ? AppTheme.colors.text : AppTheme.colors.text-dim;
                        font-size: AppTheme.font-md;
                        overflow: elide;
                        vertical-stretch: 1;
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    padding-left: AppTheme.sp-2;
                    padding-top: AppTheme.sp-1;
                    padding-bottom: AppTheme.sp-1;
                    Text { text: "VOICE"; font-size: AppTheme.font-xs; font-weight: 700; color: AppTheme.colors.text-dim; }
                }
                for c in root.channels: ListRow { visible: c.kind == "voice";
                    active: c.active;
                    pad-x: AppTheme.sp-3;
                    clicked => { root.select-channel(c.id); }
                    Text { text: "▸"; color: AppTheme.colors.text-dim; font-size: AppTheme.font-md; }
                    Text {
                        text: c.name;
                        color: c.active ? AppTheme.colors.text : AppTheme.colors.text-dim;
                        font-size: AppTheme.font-md;
                        overflow: elide;
                        vertical-stretch: 1;
                    }
                }
            }
        }
    }
}
