// Chat view — port of apps/desktop/src/lib/components/ChatView.svelte.
// Pure view: header + scrollable message list + composer.

import { AppTheme } from "theme.slint";
import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { MessageItem } from "types.slint";
import { HeaderBar, Divider } from "base.slint";

export component ChatView inherits Rectangle {
    in property <string> title;
    in property <bool> is-dm;
    in property <bool> dm-call;
    in property <[MessageItem]> messages;
    in property <string> error;
    callback send-message(string);
    callback toggle-dm-call();
    property <string> draft;

    background: AppTheme.colors.bg;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    VerticalLayout {
        width: 100%;
        height: 100%;
        HeaderBar {
            pad-x: AppTheme.sp-4;
            Text {
                text: (root.is-dm ? "DM" : "#") + " " + root.title;
                color: AppTheme.colors.text;
                font-size: AppTheme.font-base;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.is-dm : Button {
                text: root.dm-call ? "Leave" : "Call";
                primary: root.dm-call;
                clicked => { root.toggle-dm-call(); }
            }
        }
        Divider { }

        if root.messages.length > 0 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding-top: AppTheme.sp-3;
                padding-bottom: AppTheme.sp-3;
                padding-left: AppTheme.sp-4;
                padding-right: AppTheme.sp-4;
                spacing: 10px;
                for m in root.messages: VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: AppTheme.sp-2;
                        Text {
                            text: m.author;
                            color: m.mine ? AppTheme.colors.accent : AppTheme.colors.text;
                            font-size: AppTheme.font-md;
                            font-weight: 700;
                        }
                        Text { text: m.time; color: AppTheme.colors.text-dim; font-size: AppTheme.font-xs; }
                    }
                    Text {
                        text: m.content;
                        color: AppTheme.colors.text;
                        font-size: AppTheme.font-base;
                        wrap: word-wrap;
                    }
                }
            }
        }
        if root.messages.length == 0 : Rectangle {
            vertical-stretch: 1;
            Text { text: "No messages yet."; color: AppTheme.colors.text-dim; font-size: AppTheme.font-md; }
        }

        if root.error != "" : HorizontalLayout {
            padding-top: AppTheme.sp-1;
            padding-bottom: AppTheme.sp-1;
            padding-left: AppTheme.sp-4;
            padding-right: AppTheme.sp-4;
            Text { text: root.error; color: AppTheme.colors.danger; font-size: AppTheme.font-md; wrap: word-wrap; }
        }

        Divider { }
        Rectangle {
            VerticalLayout {
                padding-top: AppTheme.sp-3;
                padding-bottom: AppTheme.sp-3;
                padding-left: AppTheme.sp-4;
                padding-right: AppTheme.sp-4;
                HorizontalLayout {
                    spacing: AppTheme.sp-2;
                    LineEdit {
                        text <=> root.draft;
                        placeholder-text: "Message " + root.title;
                        horizontal-stretch: 1;
                        accepted => { root.send-message(root.draft); root.draft = ""; }
                    }
                    Button {
                        text: "Send";
                        primary: true;
                        enabled: root.draft != "";
                        clicked => { root.send-message(root.draft); root.draft = ""; }
                    }
                }
            }
        }
    }
}
