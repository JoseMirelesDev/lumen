// Friends pane — DMs, online/offline friends, incoming requests, add-friend
// box. Bust silhouettes (skin by username hash), shape-coded status dots,
// mono uppercase group labels.

import { AppTheme } from "theme.slint";
import { Icons } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { DmItem, FriendItem, FriendRequestItem } from "types.slint";
import { HeaderBar, ListRow, Divider } from "primitives/layout.slint";
import { Bust } from "primitives/identity.slint";
import { StatusDot, SectionHeader } from "primitives/chips.slint";
import { VoxButton, HeaderIconBtn } from "primitives/buttons.slint";
import { VoxLineEdit } from "primitives/inputs.slint";
import { IconGlyph } from "primitives/icon.slint";

component FriendRow inherits ListRow {
    in property <string> id;
    in property <string> label;
    in property <string> skin: "ivory";
    in property <bool> online;
    in property <int> shared: 0;
    callback remove(string);
    pad-y: 2px;
    height: 36px;

    Bust {
        skin: root.skin;
        state: "idle";
        width: 32px;
        height: 32px;
    }
    StatusDot {
        shape: root.online ? "disc" : "hollow";
        dot-color: root.online ? AppTheme.colors.online : AppTheme.colors.text-mute;
    }
    Text {
        text: root.label;
        font-family: AppTheme.font-body;
        font-weight: root.online ? 600 : 400;
        font-size: AppTheme.font-sm;
        color: root.online ? AppTheme.colors.text-hi : AppTheme.colors.text-dim;
        overflow: elide;
        horizontal-stretch: 1;
    }
    if root.shared > 0 : Text {
        text: root.shared + " en común";
        font-family: AppTheme.font-mono;
        font-size: AppTheme.font-xs;
        color: AppTheme.colors.text-mute;
        overflow: elide;
        min-width: 0px;
        vertical-alignment: center;
    }
    // "quitar amigo" (Fase 2) — hover-revealed via ListRow's exposed
    // `hovered` out-property (primitives/layout.slint).
    if root.hovered : rm-ta := TouchArea {
        width: 24px;
        height: 24px;
        mouse-cursor: pointer;
        clicked => { root.remove(root.id); }
        Rectangle {
            width: 100%;
            height: 100%;
            background: rm-ta.has-hover ? AppTheme.colors.card-hi : transparent;
            border-radius: AppTheme.radius-1;
            IconGlyph {
                glyph: Icons.x;
                size: 14px;
                text-color: rm-ta.has-hover ? AppTheme.colors.rose : AppTheme.colors.text-dim;
            }
        }
    }
}

component DmRow inherits ListRow {
    in property <string> label;
    in property <string> skin: "ivory";
    pad-y: 2px;
    height: 36px;

    Bust {
        skin: root.skin;
        state: "idle";
        width: 32px;
        height: 32px;
    }
    Text {
        text: root.label;
        font-family: AppTheme.font-body;
        font-weight: 500;
        font-size: AppTheme.font-sm;
        color: AppTheme.colors.text;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

export component FriendsView inherits Rectangle {
    in property <[DmItem]> dms;
    in property <[FriendItem]> online;
    in property <[FriendItem]> offline;
    in property <[FriendRequestItem]> requests;
    in property <string> error;
    callback open-dm(string);
    callback accept-friend(string);
    callback decline-friend(string);
    callback add-friend(string);
    callback remove-friend(string);
    callback open-settings();
    in-out property <string> request-user: "";

    width: AppTheme.sidebar-width;
    vertical-stretch: 1;
    background: AppTheme.colors.surface;

    VerticalLayout {
        width: 100%;
        height: 100%;

        HeaderBar {
            pad-x: AppTheme.sp-3;
            Text {
                text: "Amigos";
                font-family: AppTheme.font-display;
                font-weight: 700;
                font-size: AppTheme.font-title;
                color: AppTheme.colors.text-hi;
                horizontal-stretch: 1;
            }
            HeaderIconBtn {
                icon: Icons.gear-six;
                accessible-role: button;
                accessible-label: "Ajustes";
                clicked => { root.open-settings(); }
            }
        }
        Divider { }

        ScrollView {
            vertical-stretch: 1;
            // wheel-scrollable, no visible bar (matches settings panel)
            vertical-scrollbar-policy: always-off;
            VerticalLayout {
                // Guard: pin to the viewport width so no content can force a
                // horizontal scrollbar (same as login/settings ScrollViews).
                min-width: 0px;
                alignment: start;
                padding-top: AppTheme.sp-2;
                padding-bottom: AppTheme.sp-2;
                padding-left: AppTheme.sp-2;
                padding-right: AppTheme.sp-2;
                spacing: AppTheme.sp-1;

            // REQUESTS — actionable, first.
            if root.requests.length > 0 : VerticalLayout {
                spacing: AppTheme.sp-1;
                SectionHeader {
                    label: "SOLICITUDES";
                    marker-color: AppTheme.colors.rose;
                    row-height: 30px;
                }
                for r in root.requests: Rectangle {
                        height: 44px;
                        border-radius: AppTheme.radius-1;
                        HorizontalLayout {
                            alignment: start;
                            padding-left: AppTheme.sp-2;
                            padding-right: AppTheme.sp-2;
                            spacing: AppTheme.sp-2;
                            cross-axis-alignment: center;
                            IconGlyph {
                                glyph: Icons.user;
                                size: 16px;
                                text-color: AppTheme.colors.text-mute;
                            }
                            Text {
                                text: r.username;
                                font-family: AppTheme.font-body;
                                font-size: AppTheme.font-sm;
                                color: AppTheme.colors.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            VoxButton {
                                icon: Icons.check;
                                compact: true;
                                primary: true;
                                clicked => { root.accept-friend(r.id); }
                            }
                            VoxButton {
                                icon: Icons.x;
                                compact: true;
                                clicked => { root.decline-friend(r.id); }
                            }
                        }
                    }
                Divider { }
            }

            // DIRECT MESSAGES
            SectionHeader {
                label: "MENSAJES DIRECTOS";
                marker-color: AppTheme.colors.ice;
                row-height: 30px;
                pad-top: AppTheme.sp-3;
            }
            if root.dms.length == 0 : Rectangle {
                HorizontalLayout {
                    padding-left: AppTheme.sp-2;
                    Text {
                        text: "Aún no hay MDs — envía una solicitud abajo.";
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-sm;
                        color: AppTheme.colors.text-mute;
                        wrap: word-wrap;
                    }
                }
            }
            if root.dms.length > 0 : VerticalLayout {
                spacing: AppTheme.sp-1;
                for d in root.dms: DmRow {
                label: d.username;
                skin: d.skin;
                clicked => { root.open-dm(d.username); }
            }
            }
            Divider { }

            // ONLINE
            SectionHeader {
                label: "EN LÍNEA";
                marker-color: AppTheme.colors.online;
                row-height: 30px;
                pad-top: AppTheme.sp-3;
            }
            if root.online.length == 0 : Rectangle {
                                HorizontalLayout {
                    padding-left: AppTheme.sp-2;
                    Text {
                        text: "Nadie conectado.";
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-sm;
                        color: AppTheme.colors.text-mute;
                    }
                }
            }
            if root.online.length > 0 : VerticalLayout {
                spacing: AppTheme.sp-1;
                for f in root.online: FriendRow {
                id: f.id;
                label: f.username;
                skin: f.skin;
                online: true;
                shared: f.shared;
                clicked => { root.open-dm(f.username); }
                remove(id) => { root.remove-friend(id); }
            }
            }
            Divider { }

            // OFFLINE
            SectionHeader {
                label: "DESCONECTADOS";
                marker-color: AppTheme.colors.text-mute;
                row-height: 30px;
                pad-top: AppTheme.sp-3;
            }
            if root.offline.length == 0 : Rectangle {
                                HorizontalLayout {
                    padding-left: AppTheme.sp-2;
                    Text {
                        text: "Aún no tienes amigos.";
                        font-family: AppTheme.font-body;
                        font-size: AppTheme.font-sm;
                        color: AppTheme.colors.text-mute;
                    }
                }
            }
            if root.offline.length > 0 : VerticalLayout {
                spacing: AppTheme.sp-1;
                for f in root.offline: FriendRow {
                id: f.id;
                label: f.username;
                skin: f.skin;
                online: false;
                shared: f.shared;
                clicked => { root.open-dm(f.username); }
                remove(id) => { root.remove-friend(id); }
            }
            }
        }
        }

        if root.error != "" : HorizontalLayout {
            padding-left: AppTheme.sp-2;
            padding-right: AppTheme.sp-2;
            padding-top: AppTheme.sp-1;
            padding-bottom: AppTheme.sp-1;
            Text {
                text: root.error;
                font-family: AppTheme.font-mono;
                font-size: AppTheme.font-xs;
                color: AppTheme.colors.rose;
                wrap: word-wrap;
            }
        }

        Divider { }
        Rectangle {
            background: AppTheme.colors.bg-deep;
            VerticalLayout {
                padding: AppTheme.sp-2;
                HorizontalLayout {
                    spacing: AppTheme.sp-2;
                    VoxLineEdit {
                        text <=> root.request-user;
                        placeholder: "Añadir amigo por usuario";
                        horizontal-stretch: 1;
                        accepted(text) => { root.add-friend(text); }
                    }
                    VoxButton {
                        icon: Icons.paper-plane-right;
                        primary: true;
                        compact: true;
                        enabled: root.request-user != "";
                        clicked => { root.add-friend(root.request-user); }
                    }
                }
            }
        }
    }
}
