{
  "name": "@lumen/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: REST signaling API + LumenChannelDO (WebSocket Hibernation) + D1.",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply lumen-d1 --local",
    "smoke": "node test/smoke-ws.mjs"
  },
  "dependencies": {
    "@lumen/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.123.0",
    "ws": "^8.18.0"
  }
}
