+    // Transparent initial state: while the AEC has not converged (or right
+    // after an echo-path-change reset), do not apply the nonlinear
+    // suppression gain — pass the linear-filter output so near-end speech is
+    // never swallowed during convergence. The residual echo is audible
+    // briefly, the tradeoff Chrome/Meet make with their transparent AEC3
+    // initial state.
+    if (suppression_gain_.InitialStateActive()) {
+      G.fill(1.f);
+      high_bands_gain = 1.f;
+    }
